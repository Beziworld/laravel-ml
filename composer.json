{
    "name": "beziworld/laravel-ml",
    "description": "Laravel-first machine learning on Rubix ML: Eloquent datasets, model classes, versioned persistence, queued training, predictions and php-ml style tools",
    "keywords": [
        "laravel",
        "machine-learning",
        "ml",
        "rubix",
        "rubix-ml",
        "php-ml",
        "classification",
        "regression",
        "clustering",
        "apriori",
        "tf-idf",
        "eloquent",
        "prediction"
    ],
    "homepage": "https://github.com/beziworld/laravel-ml",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Kamil Ćwiertnia",
            "email": "biuro@beziworld.eu",
            "homepage": "https://beziworld.eu",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/beziworld/laravel-ml/issues",
        "source": "https://github.com/beziworld/laravel-ml"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "rubix/ml": "^3.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beziworld\\Ml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beziworld\\Ml\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beziworld\\Ml\\MlServiceProvider"
            ],
            "aliases": {
                "Ml": "Beziworld\\Ml\\Facades\\Ml"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
